# Riferimento delle variabili d'ambiente lette da local-llm-offload.
#
# Il server NON carica automaticamente questo file: quando è registrato come
# MCP server in Claude Code, le variabili vanno passate con
# `claude mcp add ... --env NOME=valore` (vedi README.md).
#
# Questo file serve solo come documentazione e per test manuali, es.:
#   set -a && source .env && set +a && uv run pytest

# URL base del server Ollama in LAN (senza slash finale).
OLLAMA_HOST=http://192.168.1.50:11434

# Modello usato quando delegate_to_local_llm non specifica `model`.
# Rapido/leggero: qwen2.5-coder:7b — corposo/potente: qwen3-coder:30b
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Timeout (secondi) per le richieste HTTP verso Ollama. Alza questo valore
# se usi modelli grandi con CPU-offload (es. qwen3-coder:30b).
OLLAMA_TIMEOUT_SECONDS=120

# Limiti applicati ai file passati via `context_files`, per non saturare
# la finestra di contesto del modello locale.
MAX_CONTEXT_FILE_CHARS=20000
MAX_TOTAL_CONTEXT_CHARS=60000

# Dove salvare il log JSONL delle chiamate a delegate_to_local_llm (token
# reali, tempo, modello), usato da get_usage_stats. Default: un file sotto
# la home dell'utente, funziona su Windows e Unix senza altre dipendenze.
USAGE_LOG_PATH=~/.local-llm-offload/usage.jsonl

# Ogni quanti chunk streammati inviare una notifica di progresso MCP
# durante la generazione (solo se il client la supporta).
PROGRESS_CHUNK_INTERVAL=20
